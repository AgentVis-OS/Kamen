# Applied by Magisk at boot (before policy load). Same intent as WD40's
# sepolicy/private/aiphoneassistant.te, with binder_call() expanded because
# magiskpolicy does not understand m4 macros.

# Screen capture via SurfaceFlinger
allow system_app surfaceflinger_service service_manager find
allow system_app surfaceflinger binder { call transfer }
allow surfaceflinger system_app binder transfer
allow system_app surfaceflinger fd use
allow surfaceflinger system_app fd use

# Input injection via InputManagerService
allow system_app input_service service_manager find
allow system_app system_server binder { call transfer }
allow system_server system_app binder transfer
